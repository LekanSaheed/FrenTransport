# The API's address, e.g. https://api.obere.ng (production) or https://<service>.onrender.com (test).
# Just the address: /api/v1 is added by the app (libs/config.ts). Compiled in at build time, so
# rebuild after changing it; a production build fails without it.
NEXT_PUBLIC_API_URL=http://localhost:4000

# The website's public address (canonical links, sitemap, share images). Use the address the
# site ends on, e.g. https://www.obere.ng if obere.ng redirects to www.
NEXT_PUBLIC_SITE_URL=https://www.obere.ng
# Search engines index only production: automatic on Vercel. On another host, set 1 for production.
# ALLOW_INDEXING=1
