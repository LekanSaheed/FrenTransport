# Where Next.js forwards /api/* (server-side only; never exposed to the browser).
BACKEND_URL=http://localhost:4000

# Leave unset to call the API through this app (recommended: first-party cookies, no CORS).
# NEXT_PUBLIC_API_URL=/api/v1

# Same value as the backend's API_PROXY_SECRET (server-side only). Lets the API see each
# customer's real IP for rate limiting. Required in production.
API_PROXY_SECRET=
