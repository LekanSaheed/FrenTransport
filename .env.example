# The API's address as the browser sees it, including /api/v1 (baked in at build time:
# rebuild after changing it). Production: e.g. https://api.obere.ng/api/v1 (a subdomain of the
# website keeps sign-in cookies first-party). The API's FRONTEND_URL must be this site's address.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
